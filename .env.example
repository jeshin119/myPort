# ── Contact form (Resend) ──
# https://resend.com/api-keys 에서 발급한 API 키
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 문의 메일을 실제로 받을 주소
CONTACT_EMAIL=you@example.com

# (선택) 보내는 사람 주소. 미설정 시 Resend 테스트 발신자(onboarding@resend.dev) 사용.
# 실제 운영에서는 Resend에서 도메인 인증 후 해당 도메인 주소로 설정하세요.
# CONTACT_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>

# ── Cloudflare Turnstile (봇/스팸 방지) ──
# https://dash.cloudflare.com → Turnstile 에서 위젯 생성 후 발급.
# 두 값 모두 설정해야 캡차 검증이 켜집니다. (미설정 시 캡차 없이 동작)
# 사이트 키는 브라우저에 노출됨 → NEXT_PUBLIC_ 접두사 필수.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
# 비밀 키는 서버 전용 (절대 커밋/노출 금지).
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxx
